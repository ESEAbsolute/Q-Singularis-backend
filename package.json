{
  "name": "q-singularis-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Q-Singularis backend (ElysiaJS + SQLite)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
