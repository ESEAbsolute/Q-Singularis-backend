    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx test/smoke.ts"
  },
  "dependencies": {
    "@elysia/node": "^1.4.6",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
