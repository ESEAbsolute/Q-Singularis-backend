# Q-Singularis backend configuration (copy to .env)
HOST=0.0.0.0
PORT=8787

# SQLite 数据库文件路径（相对 backend 目录）
DB_PATH=data/qs.db

# 上传文件根目录
UPLOAD_DIR=data/uploads

# 前端来源（CORS 允许的源，逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 与 QQ 机器人共享的密钥（内部接口鉴权），机器人 .env 需一致
BOT_SECRET=change-me-bot-secret

# 未验证账号有效期（毫秒），默认 10 分钟
VERIFY_TTL_MS=600000

# 视频审核完成后保留天数，之后删除文件（不存储）
VIDEO_KEEP_DAYS=7

# 单个视频上传大小上限（字节），默认 100MB
MAX_UPLOAD_BYTES=104857600

# 提交截图单张大小上限（字节），默认 10MB（每 raw 项最多 9 张）
MAX_NOTE_IMAGE_BYTES=10485760

# ---- 视频压制 / HLS 切片（需服务器安装 ffmpeg；auto=探测不到则原文件直传）----
# TRANSCODE_ENABLED=auto          # auto | on | off
# FFMPEG_PATH=ffmpeg              # ffmpeg 可执行文件路径
# FFPROBE_PATH=ffprobe
# TRANSCODE_ENCODER=libx265       # libx265 | libsvtav1 | libx264（不支持时自动回退）
# TRANSCODE_CRF=26
# TRANSCODE_PRESET=medium
# HLS_SEGMENT_SECONDS=6

# ---- 媒体存储：local | r2（Cloudflare R2）----
# STORAGE=local
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
